# Скопируйте в scraper/.env на сервере и заполните реальными
# значениями (теми же, что сейчас лежат в GitHub Secrets репозитория).
# Файл .env НЕ должен попадать в git — держите его только на сервере.

SUPABASE_URL=
SUPABASE_SERVICE_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_GROUP_APARTMENT=
TELEGRAM_GROUP_APARTMENT_RENT=
TELEGRAM_GROUP_COMMERCIAL=
TELEGRAM_GROUP_HOUSE=

# ИИ-классификация сейчас жёстко отключена в коде (USE_AI_CLASSIFICATION
# не читается пока константа USE_AI_CLASSIFICATION в run.js == false) —
# но переменную можно оставить для истории/на случай, если решите
# снова включить.
USE_AI_CLASSIFICATION=false
ANTHROPIC_API_KEY=

# Опционально — прокси для запросов к OLX (см. src/http.js). Если
# после переезда на VPS блокировка sale-категории уйдёт сама (см.
# обсуждение), эту переменную можно вообще не заполнять — код и без
# неё работает как раньше.
OLX_PROXY_URL=
