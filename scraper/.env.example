# Supabase: Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ВАЖНО: это service_role ключ (не anon!) — даёт полный доступ к базе,
# минуя RLS. Использовать только тут (бэкенд) и в GitHub Secrets.
# Никогда не класть его во фронтенд/client — только SUPABASE_URL там
# безопасен, ключ — нет.

# Telegram
TELEGRAM_BOT_TOKEN=123456:xxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789
# Личный chat_id (ваш диалог с ботом, НЕ группа) — сюда идут только
# служебные алерты о сбоях парсера (сайт не открылся, селектор
# перестал находить объявления и т.п., см. notifyAlert в telegram.js).
# Обычные карточки объявлений сюда не попадают, только этим — они
# идут в TELEGRAM_CHAT_ID/TELEGRAM_GROUP_* как раньше.
TELEGRAM_ADMIN_CHAT_ID=

# 3 супергруппы по типам недвижимости, с включёнными "Темами" (Topics).
# chat_id каждой — узнать так же, как TELEGRAM_CHAT_ID (через getUpdates
# после любого сообщения в группе). Бот должен быть в каждой админом
# с правом "Управление темами". Если оставить пустым — уведомления в
# эту группу просто не отправляются, ничего не сломается.
TELEGRAM_GROUP_APARTMENT=
TELEGRAM_GROUP_COMMERCIAL=
TELEGRAM_GROUP_HOUSE=

# ИИ-классификация (пока выключена)
USE_AI_CLASSIFICATION=false
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# --- AI-провайдеры для извлечения полей объявления (extractListingInfo.js)
#     и ИИ-поиска (client/api/_aiSearch.js) ---
# Приоритет: Gemini -> (если AI_FALLBACK_ENABLED=true) Groq -> OpenRouter
# -> Mistral -> SambaNova -> Cloudflare Workers AI. Если не задан ни один ключ — код тихо откатывается на
# regex-парсер, ничего не ломается.
# Cerebras убран из цепочки (19.08.2026) — их бесплатный тариф стал
# разовым $5-кредитом вместо постоянного free tier, на аккаунте
# исчерпан (стабильные 402 Payment Required), без привязки карты не
# восстановится.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# AI_FALLBACK_ENABLED=true — включает Groq/OpenRouter/Mistral как
# запасные варианты, если Gemini недоступен/упал. По умолчанию (false
# или не задано) используется только Gemini, без фолбэка на других.
AI_FALLBACK_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Опционально — OpenRouter просит их для рейтинга приложений, не
# обязательны для работы:
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=
# Mistral Experiment tier — 1 млрд токенов/мес бесплатно, постоянный
# лимит (не разовый, как был у Cerebras). console.mistral.ai
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# SambaNova Cloud free tier — cloud.sambanova.ai, без карты, 600 RPM.
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
# Cloudflare Workers AI free tier — 10 000 нейронов/день, без карты.
# ДВА значения, не один ключ: ACCOUNT_ID виден в дашборде Cloudflare
# (правая панель на любой странице), API_TOKEN создаётся отдельно
# (My Profile -> API Tokens, права Workers AI: Read).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
# Таймаут одного запроса к любому AI-провайдеру, мс (по умолчанию 15000)
AI_TIMEOUT_MS=15000

# --- Включение/отключение источников (по умолчанию оба включены —
#     задайте =false, только если источник нужно временно выключить) ---
REALTING_ENABLED=true
DOMTUT_ENABLED=true

# Курс $ к суму — используется ботом в Telegram (client/api/telegram-webhook.js
# на Vercel, НЕ этим .env) для сравнения цен в разных валютах при
# фильтрации. Нужен также скраперу (сравнение цен в $ и в сумах для
# повторных объявлений) — прописывается и в GitHub Secrets (scrape.yml);
# без него скрапер
# просто использует запасное значение 12700 из кода, но лучше держать
# оба места в актуальном курсе. Стоит периодически сверять с курсом
# ЦБ РУз (cbu.uz) и обновлять в обоих местах.
EXCHANGE_RATE_USD_UZS=11990
